{
  "name": "Webheadcoder Multi-step Forms for Contact Form 7",
  "version": "4.7.1",
  "description": "CF7MSM",
  "main": "js/index.js",
  "scripts": {
    "build": "vite build --mode production",
    "deploy": "npm run build && npm run clean && npm run copy:all",
    "clean": "rimraf deploy",
    "copy:all": "npm run copy:php && npm run copy:form-tag-assets && npm run copy:assets && npm run copy:wp-assets && npm run copy:vendor",
    "copy:php": "cpx '{*.php,form-tags/**/*.php}' 'deploy/contact-form-7-multi-step-module'",
    "copy:form-tag-assets": "cpx 'form-tags/**/*.{css,js}' 'deploy/contact-form-7-multi-step-module/form-tags'",
    "copy:assets": "cpx 'resources/**/*.{css,js,png,jpg,svg}' 'deploy/contact-form-7-multi-step-module/resources'",
    "copy:wp-assets": "cpx '{languages/**/*.pot,readme.txt}' 'deploy/contact-form-7-multi-step-module'",
    "copy:vendor": "cpx 'vendor/**' deploy/contact-form-7-multi-step-module/vendor"
  },
  "author": "webheadllc",
  "license": "GPL-2.0-or-later",
  "engines": {
    "node": ">=24 <25"
  },
  "devDependencies": {
    "cpx2": "^9.0.0",
    "rimraf": "^6.1.3",
    "sass": "^1.102.0",
    "terser": "^5.50.0",
    "vite": "^8.2.1",
    "vite-plugin-static-copy": "^4.1.1"
  },
  "allowScripts": {
    "@parcel/watcher@2.6.0": true,
    "fs-ext-extra-prebuilt@2.2.7": true,
    "fsevents@2.3.2": true,
    "fsevents@2.3.3": true
  },
  "dependencies": {}
}
